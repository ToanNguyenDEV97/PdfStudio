<UserControl x:Class="PdfStudio.App.Views.PropertiesPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <Border Width="252"
            Background="{StaticResource SurfaceSubtleBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1,1,0,0">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="14,10"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatIconButtonStyle}"
                            Command="{Binding ToggleRightPaneCommand}" MinWidth="24" MinHeight="24" Padding="4">
                        <iconPacks:PackIconMaterial Kind="Close" Width="12" Height="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                    <TextBlock Text="Thuộc tính" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <Border Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="9" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Định dạng ghi chú &amp; chữ" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,14" />

                        <TextBlock Text="Phông chữ" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                        <ComboBox Margin="0,0,0,12"
                                  ItemsSource="{Binding AvailableFonts}"
                                  SelectedItem="{Binding ActiveTab.SelectedFont}" />

                        <TextBlock Text="Cỡ chữ" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                        <ComboBox Margin="0,0,0,12"
                                  ItemsSource="{Binding AvailableFontSizes}"
                                  SelectedItem="{Binding ActiveTab.SelectedFontSize}" />

                        <TextBlock Text="Độ dày nét (Vẽ tay / Gạch dưới)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                        <Slider Minimum="1" Maximum="10" Value="{Binding ActiveTab.SelectedStrokeThickness, FallbackValue=2}" Margin="0,0,0,12" />

                        <TextBlock Text="Màu sắc" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Button Width="24" Height="24" Margin="0,0,8,0" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                    Command="{Binding SelectColorCommand}" CommandParameter="#111827" ToolTip="Đen">
                                <Ellipse Width="22" Height="22" Fill="#111827" Stroke="#D1D5DB" StrokeThickness="1.5" />
                            </Button>
                            <Button Width="24" Height="24" Margin="0,0,8,0" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                    Command="{Binding SelectColorCommand}" CommandParameter="#B91C1C" ToolTip="Đỏ đô">
                                <Ellipse Width="22" Height="22" Fill="#B91C1C" Stroke="#FECACA" StrokeThickness="1.5" />
                            </Button>
                            <Button Width="24" Height="24" Margin="0,0,8,0" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                    Command="{Binding SelectColorCommand}" CommandParameter="#FACC15" ToolTip="Vàng Highlight">
                                <Ellipse Width="22" Height="22" Fill="#FACC15" Stroke="#E5E7EB" StrokeThickness="1.5" />
                            </Button>
                            <Button Width="24" Height="24" Margin="0,0,8,0" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                    Command="{Binding SelectColorCommand}" CommandParameter="#2563EB" ToolTip="Xanh dương">
                                <Ellipse Width="22" Height="22" Fill="#2563EB" Stroke="#E5E7EB" StrokeThickness="1.5" />
                            </Button>
                            <Button Width="24" Height="24" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                    Command="{Binding SelectColorCommand}" CommandParameter="#16A34A" ToolTip="Xanh lá">
                                <Ellipse Width="22" Height="22" Fill="#16A34A" Stroke="#E5E7EB" StrokeThickness="1.5" />
                            </Button>
                        </StackPanel>

                        <Button Content="Áp dụng thay đổi" Style="{StaticResource PrimaryCrimsonButtonStyle}"
                                Command="{Binding ApplyPropertiesToSelectionCommand}" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>