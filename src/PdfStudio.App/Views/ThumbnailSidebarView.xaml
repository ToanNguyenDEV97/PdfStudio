<UserControl x:Class="PdfStudio.App.Views.ThumbnailSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <Border Width="196"
            Background="{StaticResource SurfaceSubtleBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="0,1,1,0">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="12,10"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatIconButtonStyle}"
                            Command="{Binding ToggleLeftPaneCommand}" MinWidth="24" MinHeight="24" Padding="4">
                        <iconPacks:PackIconMaterial Kind="Close" Width="12" Height="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                    <TextBlock Text="Trang thu nhỏ" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="ThumbnailScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          ScrollChanged="ThumbnailScrollViewer_ScrollChanged"
                          Padding="10">
                <ItemsControl ItemsSource="{Binding ActiveTab.Pages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,0,14" Padding="0" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="122" Height="162" Background="White" CornerRadius="6"
                                            BorderThickness="2" ClipToBounds="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#111827" Opacity="0.06" BlurRadius="8" ShadowDepth="2" />
                                        </Border.Effect>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentCrimsonBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <TextBlock Text="{Binding PageNumber}" FontSize="18" FontWeight="Light"
                                                       Foreground="#D1D5DB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding ThumbnailImage}" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Label}" Margin="0,6,0,0" FontSize="11.5"
                                               HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>