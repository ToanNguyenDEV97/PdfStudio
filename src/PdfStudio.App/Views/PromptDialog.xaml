<Window x:Class="PdfStudio.App.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Width="450" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="18">
        <Border Background="{StaticResource SurfaceWhiteBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" Opacity="0.22" BlurRadius="24" ShadowDepth="6" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header kéo thả được -->
                <Grid Grid.Row="0" Background="Transparent" Margin="20,16,12,6"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="30" Height="30" CornerRadius="8"
                            Background="{StaticResource AccentCrimsonLightBrush}"
                            Margin="0,0,10,0">
                        <iconPacks:PackIconMaterial x:Name="HeaderIcon"
                                                    Kind="Pencil" Width="16" Height="16"
                                                    Foreground="{StaticResource AccentCrimsonBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="TitleText" Grid.Column="1"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <Button Grid.Column="2" Style="{StaticResource FlatIconButtonStyle}"
                            MinWidth="28" MinHeight="28" Padding="5"
                            IsCancel="True" ToolTip="Đóng (Esc)">
                        <iconPacks:PackIconMaterial Kind="Close" Width="13" Height="13"
                                                    Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>

                <!-- Ô nhập liệu -->
                <StackPanel Grid.Row="1" Margin="20,8,20,20">
                    <TextBlock x:Name="MessageLabel"
                               TextWrapping="Wrap"
                               LineHeight="19"
                               Margin="0,0,0,12"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <TextBox x:Name="InputTextBox" Height="36" FontSize="13.5" />

                    <Border x:Name="PasswordBorder"
                            Height="36"
                            Background="White"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,0"
                            Visibility="Collapsed">
                        <PasswordBox x:Name="InputPasswordBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     FontSize="13.5"
                                     GotKeyboardFocus="InputPasswordBox_GotFocus"
                                     LostKeyboardFocus="InputPasswordBox_LostFocus" />
                    </Border>
                </StackPanel>

                <!-- Thanh nút hành động -->
                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceSubtleBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,11,11"
                        Padding="20,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy" MinWidth="84" Margin="0,0,8,0"
                                IsCancel="True"
                                Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        <Button Content="Xác nhận" MinWidth="104"
                                IsDefault="True"
                                Click="ConfirmButton_Click"
                                Style="{StaticResource PrimaryCrimsonButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>