<Window x:Class="PdfStudio.App.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13"
        Background="{StaticResource SurfaceWhiteBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <StackPanel Margin="20">
        <TextBlock x:Name="MessageLabel" TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{StaticResource TextSecondaryBrush}" />

        <TextBox x:Name="InputTextBox" Height="34" Margin="0,0,0,18" />
        <PasswordBox x:Name="InputPasswordBox" Height="34" Padding="8,6" Margin="0,0,0,18"
                     BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                     Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Width="84" Height="34" Margin="0,0,8,0"
                    IsCancel="True" Style="{StaticResource FlatIconButtonStyle}" />
            <Button Content="Xác nhận" Width="106" IsDefault="True"
                    Click="ConfirmButton_Click"
                    Style="{StaticResource PrimaryCrimsonButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>