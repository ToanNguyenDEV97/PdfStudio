<Window x:Class="PdfStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:controls="clr-namespace:PdfStudio.App.Controls"
        xmlns:views="clr-namespace:PdfStudio.App.Views"
        Title="{Binding WindowTitle}"
        Width="1366" Height="820"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="12.5"
        Foreground="{StaticResource TextPrimaryBrush}"
        Background="{StaticResource AppBackgroundBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="10" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="RecentFileRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E5EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenFileCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveDocumentCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="{Binding SaveCopyCommand}" />
        <KeyBinding Modifiers="Control" Key="F" Command="{Binding OpenSearchBarCommand}" />
        <KeyBinding Modifiers="Control" Key="P" Command="{Binding PrintDocumentCommand}" />
        <KeyBinding Modifiers="Control" Key="C" Command="{Binding CopySelectionCommand}" />
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedAnnotationCommand}" />
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding FitPageCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad0" Command="{Binding FitPageCommand}" />
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding ResetZoomCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad1" Command="{Binding ResetZoomCommand}" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding FitWidthCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad2" Command="{Binding FitWidthCommand}" />
    </Window.InputBindings>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
        <DockPanel LastChildFill="True">

            <!-- THANH TIÊU ĐỀ + QUICK ACCESS -->
            <Grid DockPanel.Dock="Top" Height="38" Background="{StaticResource AppBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Width="22" Height="22" CornerRadius="5" Background="{StaticResource AccentCrimsonBrush}" Margin="0,0,10,0">
                        <iconPacks:PackIconMaterial Kind="FileDocument" Width="13" Height="13" Foreground="White"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Button Style="{StaticResource FlatIconButtonStyle}" Command="{Binding OpenFileCommand}" ToolTip="Mở file (Ctrl+O)">
                        <iconPacks:PackIconMaterial Kind="FolderOpen" Width="15" Height="15" />
                    </Button>
                    <Button Style="{StaticResource FlatIconButtonStyle}" Command="{Binding SaveDocumentCommand}" ToolTip="Lưu (Ctrl+S)">
                        <iconPacks:PackIconMaterial Kind="ContentSave" Width="15" Height="15" />
                    </Button>
                    <Button Style="{StaticResource FlatIconButtonStyle}" Command="{Binding PrintDocumentCommand}" ToolTip="In tài liệu (Ctrl+P)">
                        <iconPacks:PackIconMaterial Kind="Printer" Width="15" Height="15" />
                    </Button>
                    <Border Width="1" Height="16" Background="{StaticResource BorderSubtleBrush}" Margin="6,0" />
                    <Button Style="{StaticResource FlatIconButtonStyle}" Command="{Binding UndoCommand}" ToolTip="Hoàn tác (Ctrl+Z)">
                        <iconPacks:PackIconMaterial Kind="Undo" Width="15" Height="15" />
                    </Button>
                    <Button Style="{StaticResource FlatIconButtonStyle}" Command="{Binding RedoCommand}" ToolTip="Làm lại (Ctrl+Y)">
                        <iconPacks:PackIconMaterial Kind="Redo" Width="15" Height="15" />
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding WindowTitle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click" ToolTip="Thu nhỏ">
                        <Path Data="M 0 0 L 10 0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click" ToolTip="Phóng to">
                        <Path x:Name="MaximizeIcon" Data="M 0 0 L 10 0 L 10 10 L 0 10 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" />
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButtonStyle}" Click="ExitButton_Click" ToolTip="Đóng">
                        <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.15" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- VÙNG 1: RIBBON -->
            <views:RibbonBarView DockPanel.Dock="Top" />

            <!-- VÙNG 5: THANH TRẠNG THÁI -->
            <!-- VÙNG 5: THANH TRẠNG THÁI -->
            <Border DockPanel.Dock="Bottom"
                    Height="34"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Điều hướng trang & Nhập số trang nhảy nhanh -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource FlatIconButtonStyle}" Command="{Binding PreviousPageCommand}"
                                MinWidth="26" MinHeight="24" Padding="4" ToolTip="Trang trước">
                            <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="15" Height="15" />
                        </Button>

                        <TextBlock Text="Trang" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="6,0,5,0" />

                        <TextBox x:Name="PageJumpTextBox"
                                 Width="44" Height="24"
                                 Padding="2,0"
                                 TextAlignment="Center"
                                 FontWeight="SemiBold"
                                 IsEnabled="{Binding HasActiveTab}"
                                 Text="{Binding ActiveTab.CurrentPage, Mode=OneWay, FallbackValue=0}"
                                 GotKeyboardFocus="PageJumpTextBox_GotKeyboardFocus"
                                 KeyDown="PageJumpTextBox_KeyDown"
                                 LostFocus="PageJumpTextBox_LostFocus" />

                        <TextBlock Text=" / " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveTab.TotalPages, FallbackValue=0}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />

                        <Button Style="{StaticResource FlatIconButtonStyle}" Command="{Binding NextPageCommand}"
                                MinWidth="26" MinHeight="24" Padding="4" ToolTip="Trang sau">
                            <iconPacks:PackIconMaterial Kind="ChevronRight" Width="15" Height="15" />
                        </Button>
                    </StackPanel>

                    <!-- Fit Width / Fit Page & Thanh trượt Zoom -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource FlatIconButtonStyle}" Command="{Binding FitWidthCommand}"
                                MinWidth="28" MinHeight="24" Padding="4" ToolTip="Vừa chiều rộng (Ctrl+2)">
                            <iconPacks:PackIconMaterial Kind="ArrowExpandHorizontal" Width="15" Height="15" />
                        </Button>
                        <Button Style="{StaticResource FlatIconButtonStyle}" Command="{Binding FitPageCommand}"
                                MinWidth="28" MinHeight="24" Padding="4" ToolTip="Vừa trọn trang (Ctrl+0)">
                            <iconPacks:PackIconMaterial Kind="Fullscreen" Width="15" Height="15" />
                        </Button>

                        <Border Width="1" Height="14" Background="{StaticResource BorderSubtleBrush}" Margin="8,0" />

                        <Button Style="{StaticResource FlatIconButtonStyle}" Command="{Binding ZoomOutCommand}"
                                MinWidth="26" MinHeight="24" Padding="4" ToolTip="Thu nhỏ">
                            <iconPacks:PackIconMaterial Kind="MagnifyMinus" Width="15" Height="15" />
                        </Button>
                        <Slider Width="116" Minimum="25" Maximum="400" Margin="6,0"
                                Value="{Binding ActiveTab.ZoomPercent, FallbackValue=100}" />
                        <Button Style="{StaticResource FlatIconButtonStyle}" Command="{Binding ZoomInCommand}"
                                MinWidth="26" MinHeight="24" Padding="4" ToolTip="Phóng to">
                            <iconPacks:PackIconMaterial Kind="MagnifyPlus" Width="15" Height="15" />
                        </Button>

                        <Button Style="{StaticResource FlatIconButtonStyle}" Command="{Binding ResetZoomCommand}"
                                MinWidth="48" MinHeight="24" Padding="4,2" Margin="2,0,0,0"
                                ToolTip="Nhấn để đặt lại 100% (Ctrl+1)">
                            <TextBlock Text="{Binding ActiveTab.ZoomPercent, StringFormat={}{0:0}%, FallbackValue=100%}"
                                       FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- KHU VỰC NỘI DUNG CHÍNH (TRÁI - GIỮA - PHẢI) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Thanh công cụ dọc ngoài cùng bên trái -->
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceWhiteBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,1,1,0">
                    <StackPanel Margin="0,10">
                        <Button Style="{StaticResource FlatIconButtonStyle}" Margin="6,4" Width="34" Height="34"
                                Command="{Binding ToggleLeftPaneCommand}" ToolTip="Trang thu nhỏ (Thumbnails)">
                            <iconPacks:PackIconMaterial Kind="FileMultiple" Width="18" Height="18"
                                                        Foreground="{StaticResource AccentCrimsonBrush}" />
                        </Button>
                        <Button Style="{StaticResource FlatIconButtonStyle}" Margin="6,4" Width="34" Height="34"
                                IsEnabled="False" Opacity="0.4" ToolTip="Mục lục (Sắp ra mắt)">
                            <iconPacks:PackIconMaterial Kind="Bookmark" Width="18" Height="18" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                        <Button Style="{StaticResource FlatIconButtonStyle}" Margin="6,4" Width="34" Height="34"
                                IsEnabled="False" Opacity="0.4" ToolTip="Danh sách Bình luận (Sắp ra mắt)">
                            <iconPacks:PackIconMaterial Kind="Comment" Width="18" Height="18" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                        <Button Style="{StaticResource FlatIconButtonStyle}" Margin="6,4" Width="34" Height="34"
                                IsEnabled="False" Opacity="0.4" ToolTip="Tệp đính kèm (Sắp ra mắt)">
                            <iconPacks:PackIconMaterial Kind="Paperclip" Width="18" Height="18" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- VÙNG 2: CỘT THUMBNAILS -->
                <views:ThumbnailSidebarView x:Name="ThumbnailSidebar"
                                            Grid.Column="1"
                                            Visibility="{Binding IsLeftPaneVisible, Converter={StaticResource BoolToVis}}" />

                <!-- VÙNG 3: MULTI-TAB & VIEWPORT -->
                <DockPanel Grid.Column="2" Background="{StaticResource CanvasWorkspaceBrush}">
                    <Border DockPanel.Dock="Top" Background="{StaticResource AppBackgroundBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,1" Padding="8,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatIconButtonStyle}"
                                    Command="{Binding OpenFileCommand}" ToolTip="Mở thêm file PDF" Margin="4,4">
                                <iconPacks:PackIconMaterial Kind="Plus" Width="15" Height="15" />
                            </Button>

                            <TabControl ItemsSource="{Binding Tabs}"
                                        SelectedItem="{Binding ActiveTab}"
                                        ItemContainerStyle="{StaticResource DocumentTabItemStyle}"
                                        Background="Transparent" BorderThickness="0" Padding="0">
                                <TabControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="FileDocument" Width="15" Height="15"
                                                                        Foreground="{StaticResource AccentCrimsonBrush}" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding TabDisplayName}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Button Margin="8,0,0,0" MinWidth="20" MinHeight="20" Padding="3" Style="{StaticResource FlatIconButtonStyle}"
                                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <iconPacks:PackIconMaterial Kind="Close" Width="10" Height="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.ContentTemplate>
                                    <DataTemplate />
                                </TabControl.ContentTemplate>
                            </TabControl>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <controls:PdfViewportControl x:Name="ViewportControl"
                                                     DataContext="{Binding ActiveTab}"
                                                     Visibility="{Binding DataContext.HasActiveTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveTab}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Border Width="64" Height="64" CornerRadius="16" Background="White" Margin="0,0,0,14" HorizontalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect Color="#111827" Opacity="0.08" BlurRadius="16" ShadowDepth="3" />
                                </Border.Effect>
                                <iconPacks:PackIconMaterial Kind="FileDocument" Width="30" Height="30"
                                                            Foreground="{StaticResource AccentCrimsonBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="Chưa có tài liệu PDF nào đang mở" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="Kéo thả tệp .pdf vào cửa sổ này hoặc nhấn Ctrl+O để bắt đầu"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,18" />
                            <Button Content="Mở tệp PDF..." Style="{StaticResource PrimaryCrimsonButtonStyle}"
                                    Command="{Binding OpenFileCommand}" HorizontalAlignment="Center" Width="150" />

                            <!-- Thẻ danh sách Tệp mở gần đây -->
                            <Border Width="520"
                                    Margin="0,24,0,0"
                                    Background="{StaticResource SurfaceWhiteBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVis}}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#111827" Opacity="0.07" BlurRadius="16" ShadowDepth="3" />
                                </Border.Effect>

                                <StackPanel>
                                    <Border Padding="16,11,12,11"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource FlatIconButtonStyle}"
                                                    MinHeight="24" Padding="8,3"
                                                    Command="{Binding ClearRecentFilesCommand}"
                                                    ToolTip="Xóa toàn bộ lịch sử mở tệp">
                                                <TextBlock Text="Xóa tất cả" FontSize="11.5"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Button>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <iconPacks:PackIconMaterial Kind="History" Width="15" Height="15"
                                                                            Foreground="{StaticResource AccentCrimsonBrush}"
                                                                            Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Tệp mở gần đây" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Padding="6">
                                        <ItemsControl ItemsSource="{Binding RecentFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Button Grid.Column="0"
                                                                Style="{StaticResource RecentFileRowButtonStyle}"
                                                                Command="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding FilePath}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="7"
                                                                        Background="{StaticResource AccentCrimsonLightBrush}"
                                                                        Margin="0,0,10,0">
                                                                    <iconPacks:PackIconMaterial Kind="FileDocument" Width="16" Height="16"
                                                                                                Foreground="{StaticResource AccentCrimsonBrush}"
                                                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding DirectoryPath}" FontSize="11.5"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="2" Text="{Binding LastOpenedDisplay}"
                                                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                                           VerticalAlignment="Center" Margin="12,0,4,0" />
                                                            </Grid>
                                                        </Button>

                                                        <Button Grid.Column="1"
                                                                Style="{StaticResource FlatIconButtonStyle}"
                                                                MinWidth="26" MinHeight="26" Padding="4" Margin="2,0,4,0"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding DataContext.RemoveRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Xóa khỏi danh sách">
                                                            <iconPacks:PackIconMaterial Kind="Close" Width="12" Height="12"
                                                                                        Foreground="{StaticResource TextMutedBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <!-- VÙNG 4: BẢNG THUỘC TÍNH -->
                <views:PropertiesPanelView Grid.Column="3"
                                           Visibility="{Binding IsRightPaneVisible, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DockPanel>
    </Border>
</Window>